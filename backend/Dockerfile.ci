FROM gradle:9-jdk21-alpine AS build

WORKDIR /workspace

# 의존성 입력을 소스와 분리해 registry build cache에서 재사용한다.
COPY --chown=gradle:gradle gradle gradle
COPY --chown=gradle:gradle gradlew build.gradle settings.gradle gradle.properties ./
RUN JAVA_TOOL_OPTIONS=-XX:TieredStopAtLevel=1 \
    ./gradlew dependencies --configuration runtimeClasspath --no-daemon

ARG RUNTIME_MODULES="java.base,java.compiler,java.desktop,java.instrument,java.net.http,java.prefs,java.rmi,java.scripting,java.security.jgss,java.security.sasl,java.sql.rowset,jdk.jfr,jdk.management,jdk.net,jdk.unsupported,jdk.charsets,jdk.crypto.ec,jdk.naming.dns"
RUN jlink --add-modules "${RUNTIME_MODULES}" \
    --strip-debug --no-man-pages --no-header-files \
    --compress=zip-6 --output build/jre

COPY --chown=gradle:gradle src/main src/main
RUN JAVA_TOOL_OPTIONS=-XX:TieredStopAtLevel=1 \
        ./gradlew bootJar -x test -x integrationTest --no-daemon \
    && java -Djarmode=tools -jar build/libs/app.jar extract \
        --layers --destination build/extracted \
    && required_modules="$(jdeps --multi-release 21 --ignore-missing-deps \
        --print-module-deps \
        --class-path 'build/extracted/dependencies/lib/*:build/extracted/snapshot-dependencies/lib/*' \
        build/extracted/application/app.jar)" \
    && available_modules="$(build/jre/bin/java --list-modules | cut -d@ -f1)" \
    && for runtime_module in $(printf '%s' "${required_modules}" | tr ',' ' '); do \
        printf '%s\n' "${available_modules}" | grep -qx "${runtime_module}" || { \
            echo "custom JRE is missing module: ${runtime_module}" >&2; exit 1; \
        }; \
    done

FROM alpine:3.23

WORKDIR /app
RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates fontconfig ttf-dejavu tzdata \
    && addgroup -S spring \
    && adduser -S spring -G spring

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

COPY --from=build /workspace/build/jre/ ${JAVA_HOME}/

# Spring Boot의 안정 의존성 레이어를 애플리케이션 코드와 분리한다. 일반 커밋은
# fat JAR 전체 대신 수백 KB application 레이어만 registry에 다시 푸시한다.
COPY --from=build /workspace/build/extracted/dependencies/ ./
COPY --from=build /workspace/build/extracted/spring-boot-loader/ ./
COPY --from=build /workspace/build/extracted/snapshot-dependencies/ ./
COPY --from=build /workspace/build/extracted/application/ ./

USER spring:spring
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
