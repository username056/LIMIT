{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListMediaPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::l1mit-dev-media-0b849303",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "tmp/*",
            "listings/*",
            "evidence/*",
            "chat/*",
            "members/*"
          ]
        }
      }
    },
    {
      "Sid": "ManageMediaObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::l1mit-dev-media-0b849303/tmp/*",
        "arn:aws:s3:::l1mit-dev-media-0b849303/listings/*",
        "arn:aws:s3:::l1mit-dev-media-0b849303/evidence/*",
        "arn:aws:s3:::l1mit-dev-media-0b849303/chat/*",
        "arn:aws:s3:::l1mit-dev-media-0b849303/members/*"
      ]
    }
  ]
}
