MYSQL_URL=jdbc:mysql://localhost:13306/limit
MYSQL_DATABASE=limit
MYSQL_USER=limit
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=1
MONGODB_ROOT_USER=root
MONGODB_ROOT_PASSWORD=
MONGODB_URI=
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=

# 운영 Blue-Green 배포와 모니터링
# 실제 이미지 digest, 비밀번호, Secret 파일 경로는 운영 Secret에만 둡니다.
MONITORING_SECRET_GID=1000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
MYSQL_EXPORTER_CONFIG_FILE=
ALERTMANAGER_SMTP_PASSWORD_FILE=
BACKEND_BLUE_IMAGE=
BACKEND_GREEN_IMAGE=
BACKEND_PORT=18080
JWT_SECRET=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Toss Payments
# 실제 키는 배포 환경의 보호 변수로 관리합니다.
TOSS_PAYMENTS_SECRET_KEY=
# 지급대행·셀러 웹훅 서명 검증에만 사용합니다.
TOSS_PAYMENTS_SECURITY_KEY=
TOSS_PAYMENTS_API_VERSION=

RTC_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173
RTC_STUN_URL=stun:stun.l.google.com:19302
RTC_TURN_URL=turn:api.l1mit.shop:3478?transport=udp
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=
RTC_TURN_REALM=l1mit.shop
OAUTH_ATTEMPT_STORE=redis
OAUTH_STATE_TTL=10m
SOCIAL_SIGNUP_STORE=redis
SOCIAL_SIGNUP_TTL=15m

# DB 백업
BACKUP_UPLOAD_ENABLED=false

BACKUP_S3_URI=
BACKUP_KMS_KEY_ID=
BACKUP_LOCAL_RETENTION_DAYS=3

# 상품 이미지·체크리스트 증빙 S3
# EC2에서는 Instance Profile을 우선하고, 불가능할 때만 전용 최소 권한 IAM 사용자 키를 사용한다.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_MEDIA_BUCKET=
S3_ENDPOINT=
S3_PATH_STYLE_ACCESS=false
S3_UPLOAD_TTL=600s
S3_DOWNLOAD_TTL=300s
S3_PUBLIC_BASE_URL=
S3_UPLOAD_CLEANUP_DELAY_MS=3600000
S3_UPLOAD_CLEANUP_INITIAL_DELAY_MS=60000
S3_FFPROBE_ENABLED=false
S3_FFPROBE_EXECUTABLE=ffprobe
S3_FFPROBE_TIMEOUT=15s

# 약관 버전은 실제 게시 문서가 바뀔 때 함께 변경합니다.
TERMS_SERVICE_VERSION=2026-07-22
TERMS_PRIVACY_VERSION=2026-07-22
TERMS_AGE_VERSION=2026-07-22
TERMS_MARKETING_VERSION=2026-07-22

# 이메일 인증
EMAIL_VERIFICATION_STORE=redis
EMAIL_VERIFICATION_DELIVERY_ENABLED=true
EMAIL_VERIFICATION_TTL=15m
FRONTEND_EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
AUTH_RATE_LIMIT_STORE=redis
EMAIL_VERIFICATION_RATE_LIMIT_MAX_ATTEMPTS=3
EMAIL_VERIFICATION_RATE_LIMIT_WINDOW=10m
PASSWORD_RESET_STORE=redis
PASSWORD_RESET_DELIVERY_ENABLED=true
PASSWORD_RESET_TTL=15m
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS=3
PASSWORD_RESET_RATE_LIMIT_WINDOW=10m

# SMTP 구글
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# OAuth2 설정
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URIS=http://localhost:5173/auth/callback/google

KAKAO_OAUTH_ENABLED=false
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URIS=http://localhost:5173/auth/callback/kakao

NAVER_OAUTH_ENABLED=false
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_REDIRECT_URIS=http://localhost:5173/auth/callback/naver


# 관리자 도메인 관련 설정
# 최초 생성할 때만 true로 변경하고 생성 후 즉시 false로 되돌립니다.

INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_ROLE=SUPER_ADMIN

# 로컬·스테이징 테스트 계정 초기화
# 실제 값은 .env.local 또는 운영 Secret에만 두고 생성 후 false로 되돌립니다.
BASE_INIT_ENABLED=false
BASE_INIT_MEMBER_ENABLED=true
BASE_INIT_MEMBER_EMAIL=
BASE_INIT_MEMBER_PASSWORD=
BASE_INIT_MEMBER_NICKNAME=
BASE_INIT_MEMBER_PHONE=
BASE_INIT_ADMIN_ENABLED=true
BASE_INIT_ADMIN_EMAIL=
BASE_INIT_ADMIN_PASSWORD=
BASE_INIT_ADMIN_NAME=

# OCR 호출
NAVER_CLOVA_OCR_INVOKE_URL=
NAVER_CLOVA_OCR_SECRET_KEY=

# 노트북 체크리스트 AI 보강
# false면 OpenAI 키 없이 검증된 기본 체크리스트만 생성합니다.
AI_CHECKLIST_ENABLED=false
OPENAI_API_KEY=
OPENAI_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses
OPENAI_CHECKLIST_MODEL=gpt-5.6-luna
AI_CHECKLIST_ALLOWED_DOMAINS=samsung.com,lg.com,microsoft.com,lenovo.com,dell.com,hp.com,asus.com,acer.com,msi.com
AI_CHECKLIST_CONNECT_TIMEOUT=5s
AI_CHECKLIST_READ_TIMEOUT=30s
