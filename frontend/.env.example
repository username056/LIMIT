# 개발 환경에서는 vite.config.js의 proxy 설정으로 /api가 localhost:18080으로 전달되므로
# VITE_API_BASE_URL은 보통 '/api/v1'로 두면 됩니다.
# 배포 환경에서는 실제 API 도메인으로 교체하세요.
VITE_API_BASE_URL=/api/v1
VITE_TOSS_PAYMENTS_CLIENT_KEY=
VITE_OAUTH_REDIRECT_BASE_URL=http://localhost:5173
VITE_TERMS_OF_SERVICE_URL=/terms/service
VITE_PRIVACY_POLICY_URL=/terms/privacy
VITE_LEGAL_OPERATOR_NAME=L1MIT 운영팀
VITE_LEGAL_REPRESENTATIVE=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_CONTACT_EMAIL=privacy@l1mit.shop
VITE_LEGAL_BUSINESS_NUMBER=
VITE_LEGAL_EFFECTIVE_DATE=2026-07-22

# 비어 있으면 브라우저 오류 수집이 비활성화됩니다. DSN은 브라우저에 공개되는 값입니다.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# CI에서는 commit SHA가 자동으로 주입됩니다.
VITE_SENTRY_RELEASE=

VITE_TOSS_PAYMENTS_CLIENT_KEY=
# Windows 자동 진단 프로그램 다운로드 URL. 배포 파일이 준비되지 않았으면 비워 둔다.
VITE_WINDOWS_SCANNER_URL=
